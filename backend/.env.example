# Meta WhatsApp Business Cloud API (secrets stay on the backend ONLY)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=1477889452064420
GRAPH_API_VERSION=v25.0

# MongoDB (local: mongodb://127.0.0.1:27017 ; Atlas: mongodb+srv://user:pass@cluster.mongodb.net)
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=whatsapp_messenger

# Login (single admin). All three are REQUIRED; the server won't start without them.
# AUTH_SECRET: any random string of 16+ characters (signs login tokens).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
AUTH_SECRET=
SESSION_HOURS=12

# Phone handling
DEFAULT_COUNTRY_CODE=91

# Server
PORT=5000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Optional: webhook (delivery status updates)
WEBHOOK_VERIFY_TOKEN=
# Optional: Meta App Secret, enables X-Hub-Signature-256 verification on webhook POSTs
WHATSAPP_APP_SECRET=

